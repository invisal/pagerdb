---
import Layout from "../../layouts/Layout.astro";
import Masthead from "../../components/sections/Masthead.astro";
import Colophon from "../../components/sections/Colophon.astro";
import SqllogictestCoverage, {
  type CoveragePayload,
} from "../../components/SqllogictestCoverage";

const DATA_URL = "https://invisal.github.io/pagerdb/sqllogictest.json";

let payload: CoveragePayload | null = null;
let loadError: string | null = null;

try {
  const response = await fetch(DATA_URL);
  if (!response.ok) {
    throw new Error(`Request failed with ${response.status}`);
  }

  payload = (await response.json()) as CoveragePayload;
} catch (error) {
  loadError = error instanceof Error ? error.message : "Unknown error";
}
---

<Layout title="PagerDB — sqllogictest coverage">
  <Masthead />
  {
    payload ? (
      <SqllogictestCoverage payload={payload} />
    ) : (
      <section class="max-w-[1280px] mx-auto px-[var(--gutter)] py-[var(--row)]">
        <div class="border border-rule bg-bg2 p-6 sm:p-8">
          <div class="font-mono text-[11px] uppercase tracking-[0.10em] text-ink3 mb-4">
            coverage report
          </div>
          <h1 class="m-0 text-[clamp(28px,3.5vw,44px)] leading-[1.05] tracking-[-0.03em] font-normal text-ink">
            Could not load the report
          </h1>
          <p class="mt-4 mb-0 text-ink2 leading-[1.7] max-w-[64ch]">
            The coverage data is fetched at build time from the published JSON
            below. Something went wrong during this build.
          </p>
          <p class="mt-3 mb-0 font-mono text-[12px] text-accent">
            error: {loadError}
          </p>
          <a
            href={DATA_URL}
            target="_blank"
            rel="noopener"
            class="mt-6 inline-flex font-mono text-[12px] tracking-[0.06em] px-4 py-[10px] border border-rule text-ink no-underline uppercase hover:bg-accent hover:border-accent hover:text-white"
          >
            open raw json
          </a>
        </div>
      </section>
    )
  }
  <Colophon />
</Layout>
