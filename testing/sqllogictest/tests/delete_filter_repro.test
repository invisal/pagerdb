# Reproduction: DELETE with WHERE clause incorrectly deletes rows that don't
# match the predicate.
#
# Minimal case: both rows have col0 > 9602; DELETE WHERE col0 < 9602 should
# delete 0 rows, but instead deletes all rows.

statement ok
CREATE TABLE t_del_repro(pk INTEGER PRIMARY KEY, col0 INTEGER, col1 FLOAT, col2 TEXT, col3 INTEGER, col4 FLOAT, col5 TEXT)

statement ok
INSERT INTO t_del_repro VALUES(189,9888,652.93,'kfssx',2008,4451.14,'oycij')

statement ok
INSERT INTO t_del_repro VALUES(2,9978,7211.99,'yydvx',1127,264.77,'pwlal')

# Verify the rows exist and col0 values are correct before DELETE.
# rowsort compares values as strings: "189" < "2", so pk=189 row sorts first.
query II rowsort
SELECT pk, col0 FROM t_del_repro
----
189
9888
2
9978

# The filter on its own must match nothing.
query I
SELECT COUNT(*) FROM t_del_repro WHERE col0 < 9602
----
0

# DELETE using the same predicate — should be a no-op.
statement ok
DELETE FROM t_del_repro WHERE col0 < 9602

# Both rows must still be present.
query II rowsort
SELECT pk, col0 FROM t_del_repro
----
189
9888
2
9978

statement ok
DROP TABLE t_del_repro

# ── Larger case: sentinel row pk=476 must survive a partial delete ─────────────
# The upstream failure involved ~70 rows. pk=476 has col0=9888 and col3=9985,
# so it must not be deleted by WHERE col0 < 9602.

statement ok
