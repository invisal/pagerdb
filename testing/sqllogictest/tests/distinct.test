# DISTINCT tests.

statement ok
CREATE TABLE nums (n INTEGER NOT NULL);

statement ok
INSERT INTO nums VALUES (1), (2), (1), (3), (2);

# Duplicates removed
query I
SELECT DISTINCT n FROM nums ORDER BY n;
----
1
2
3

# Already-unique rows: DISTINCT is a no-op
statement ok
CREATE TABLE unique_nums (n INTEGER NOT NULL);

statement ok
INSERT INTO unique_nums VALUES (10), (20), (30);

query I
SELECT DISTINCT n FROM unique_nums ORDER BY n;
----
10
20
30

# Empty table: DISTINCT on no rows returns no rows
statement ok
CREATE TABLE empty_nums (n INTEGER NOT NULL);

query I
SELECT DISTINCT n FROM empty_nums;
----

# DISTINCT with WHERE
query I
SELECT DISTINCT n FROM nums WHERE n > 1 ORDER BY n;
----
2
3

# Multi-column: deduplicates on all columns together
statement ok
CREATE TABLE pairs (a INTEGER NOT NULL, b INTEGER NOT NULL);

statement ok
INSERT INTO pairs VALUES (1, 1), (1, 2), (1, 1), (2, 1);

query II
SELECT DISTINCT a, b FROM pairs ORDER BY a, b;
----
1
1
1
2
2
1
