# Drop table with indexes removes index catalog entries cleanly
statement ok
CREATE TABLE t2 (a INTEGER, b TEXT)

statement ok
CREATE UNIQUE INDEX idx_t2_a ON t2 (a)

statement ok
INSERT INTO t2 VALUES (1, 'x')

statement ok
DROP TABLE t2

# Re-create t2 with same index name — would fail if catalog entry wasn't cleaned up
statement ok
CREATE TABLE t2 (a INTEGER, b TEXT)

statement ok
CREATE UNIQUE INDEX idx_t2_a ON t2 (a)

statement ok
DROP TABLE t2
