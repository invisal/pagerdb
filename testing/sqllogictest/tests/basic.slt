# Basic DDL, DML, and SELECT tests.

statement ok
CREATE TABLE t (id INTEGER NOT NULL, name TEXT NOT NULL);

statement ok
INSERT INTO t VALUES (1, 'alice');

statement ok
INSERT INTO t VALUES (2, 'bob');

statement ok
INSERT INTO t VALUES (3, 'carol');

# Row count
query I
SELECT COUNT(*) FROM t;
----
3

# All rows, sorted by id to get deterministic order
query IT rowsort
SELECT id, name FROM t;
----
1
alice
2
bob
3
carol

# Point lookup by id
query IT
SELECT id, name FROM t WHERE id = 2;
----
2
bob

# UPDATE and verify
statement ok
UPDATE t SET name = 'ALICE' WHERE id = 1;

query T
SELECT name FROM t WHERE id = 1;
----
ALICE

# DELETE and verify count
statement ok
DELETE FROM t WHERE id = 3;

query I
SELECT COUNT(*) FROM t;
----
2

# Error: select from nonexistent table
statement error
SELECT x FROM no_such_table;

# Error: reference nonexistent column
statement error
SELECT bad_col FROM t;
