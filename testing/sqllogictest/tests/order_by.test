# ORDER BY tests — single table `nums` covers most cases;
# separate tables are used where the schema differs.

statement ok
CREATE TABLE nums (n INTEGER NOT NULL);

statement ok
INSERT INTO nums VALUES (3), (1), (2);

# Single column ASC (default)
query I
SELECT n FROM nums ORDER BY n;
----
1
2
3

# Single column ASC explicit
query I
SELECT n FROM nums ORDER BY n ASC;
----
1
2
3

# Single column DESC
query I
SELECT n FROM nums ORDER BY n DESC;
----
3
2
1

# Positional reference (ORDER BY 1)
query I
SELECT n FROM nums ORDER BY 1 DESC;
----
3
2
1

# Expression in ORDER BY
query I
SELECT n FROM nums ORDER BY n + 0 ASC;
----
1
2
3

# Column alias in ORDER BY
query I
SELECT n AS val FROM nums ORDER BY val DESC;
----
3
2
1

# WITH WHERE
statement ok
CREATE TABLE many_nums (n INTEGER NOT NULL);

statement ok
INSERT INTO many_nums VALUES (5), (1), (3), (2), (4);

query I
SELECT n FROM many_nums WHERE n > 2 ORDER BY n DESC;
----
5
4
3

# Multi-key: ORDER BY b ASC, a ASC
statement ok
CREATE TABLE pairs (a INTEGER NOT NULL, b INTEGER NOT NULL);

statement ok
INSERT INTO pairs VALUES (2, 1), (1, 2), (1, 1), (2, 2);

query II
SELECT a, b FROM pairs ORDER BY 2 ASC, 1 ASC;
----
1
1
2
1
1
2
2
2

# Text column
statement ok
CREATE TABLE people (name TEXT NOT NULL);

statement ok
INSERT INTO people VALUES ('charlie'), ('alice'), ('bob');

query T
SELECT name FROM people ORDER BY name ASC;
----
alice
bob
charlie

# WITH GROUP BY — one row per group, ordered by group key
statement ok
CREATE TABLE dept_rows (dept TEXT NOT NULL, n INTEGER NOT NULL);

statement ok
INSERT INTO dept_rows VALUES ('b', 1), ('a', 2), ('b', 3), ('a', 4);

query T
SELECT dept FROM dept_rows GROUP BY dept ORDER BY 1 ASC;
----
a
b

# NULL values sort first in ASC order
statement ok
CREATE TABLE nullable_nums (n INTEGER);

statement ok
INSERT INTO nullable_nums VALUES (2), (null), (1);

query I
SELECT n FROM nullable_nums ORDER BY n ASC;
----
NULL
1
2
